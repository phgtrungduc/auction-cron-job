# Database
# Local PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/auction_db
# Supabase (pooler - recommended)
DATABASE_URL=postgresql://postgres.xxxxx:your_password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# SSL: true (cloud), false (local dev)
DATABASE_SSL=true

# Connection pool (default: 10)
DATABASE_POOL_MAX=10

# Scheduler
CRON_ENABLED=true
NOTICE_SCAN_CRON=*/15 * * * *
NOTICE_SCAN_DAILY_CRON=0 3 * * *
TZ=Asia/Ho_Chi_Minh

# Correction
SCAN_BATCH_SIZE=500

# Logging
LOG_LEVEL=info
