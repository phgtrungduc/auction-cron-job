[Unit]
Description=Auction Cron Job - Data Correction Service
After=network.target postgresql.service

[Service]
Type=simple
User=bn888_user
WorkingDirectory=/home/bn888_user/app/auction-cron-job
Environment="NODE_ENV=production"
EnvironmentFile=/home/bn888_user/app/auction-cron-job/.env
ExecStart=/usr/bin/env node dist/main.js
Restart=on-failure
RestartSec=10s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auction-cron-job

[Install]
WantedBy=multi-user.target
